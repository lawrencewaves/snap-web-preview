# SNAP SURF TRIPS · Apache (Dinahosting)
Options -Indexes -MultiViews
ServerSignature Off
LimitRequestBody 65536
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# 1) HTTPS: NO activar aquí una regla con %{HTTPS} off: en Dinahosting provocó un bucle de redirecciones
#    (ERR_TOO_MANY_REDIRECTS, 23/11/2026). El HTTPS forzado desde http:// se resolvió aparte en el servidor.
# 2) Host canónico: build.py genera aquí la regla www → dominio sin www (funciona en producción).
#    Si el dominio canónico lleva www, no se genera.
#WWW2APEX#
# summary.php solo lo ejecuta el cron del hosting; config y data nunca se sirven
RewriteRule ^api/(config(\.sample)?\.php|summary\.php|data/) - [F,L]
# Archivos ocultos (.git, .env…) y extensiones sensibles: prohibidos (salvo .well-known)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(sqlite|db|py|log|bak|sql|ini|sh|md|zip)$ - [F,L,NC]
# Solo POST a los scripts que lo necesitan
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
RewriteRule .* - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
#CSP#
Header always set Cross-Origin-Opener-Policy "same-origin"
Header unset X-Powered-By
# HSTS: el navegador solo usará HTTPS. Empieza en 1 semana (si algo fallara, el bloqueo dura poco); cuando todo vaya bien
# unas semanas, subir a 31536000 (1 año). Sin includeSubDomains ni preload a propósito.
Header always set Strict-Transport-Security "max-age=604800"
Header always set X-Permitted-Cross-Domain-Policies "none"
<FilesMatch "\.php$">
Header set Cache-Control "no-store"
Header set X-Robots-Tag "noindex"
</FilesMatch>
<FilesMatch "\.(woff2|webp|jpg|png|svg)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain application/xml image/svg+xml
</IfModule>
