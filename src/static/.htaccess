# SNAP SURF TRIPS · Apache (Dinahosting)
Options -Indexes -MultiViews
ServerSignature Off
LimitRequestBody 65536
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# 1) Con SSL activo: quitar las # de estas dos líneas para forzar HTTPS
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# 2) Una sola versión del dominio (con www). Cambiar TU-DOMINIO y quitar las #
# RewriteCond %{HTTP_HOST} ^TU-DOMINIO\.com$ [NC]
# RewriteRule ^ https://www.TU-DOMINIO.com%{REQUEST_URI} [L,R=301]
RewriteRule ^api/(config(\.sample)?\.php|data/) - [F,L]
# Archivos ocultos (.git, .env…) y extensiones sensibles: prohibidos (salvo .well-known)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(sqlite|db|py|log|bak|sql|ini|sh|md|zip)$ - [F,L,NC]
# Solo POST a los scripts que lo necesitan
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
RewriteRule .* - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
#CSP#
Header always set Cross-Origin-Opener-Policy "same-origin"
Header unset X-Powered-By
# Con SSL activo: quitar la # (obliga a HTTPS durante 1 año)
# Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(woff2|webp|jpg|png|svg)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain application/xml image/svg+xml
</IfModule>
